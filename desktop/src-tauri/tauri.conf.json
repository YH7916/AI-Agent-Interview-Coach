{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Agent Interview Coach",
  "version": "0.1.2",
  "identifier": "dev.lyh.interview-agent",
  "build": {
    "frontendDist": "../../frontend",
    "devUrl": "http://127.0.0.1:8000/v3",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/interview-agent-sidecar"
    ],
    "windows": {
